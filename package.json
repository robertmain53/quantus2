{
  "name": "fidamen-content-platform",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "prepare-prompts": "node scripts/generate-prompts.js",
    "lint:configs": "node scripts/lint-configs.js",
    "qa:versioning": "tsx scripts/qa-versioning.mjs",
    "build": "npm run lint:configs && npm run qa:versioning && next build",
    "generate:prompts": "node scripts/generate-prompts.js",
    "cleanup:prompts": "node scripts/cleanup-prompt-assets.js",
    "prompts:full": "npm run generate:prompts && npm run cleanup:prompts"
  },
  "dependencies": {
    "next": "14.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.10",
    "@types/node": "20.9.3",
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.15",
    "autoprefixer": "10.4.16",
    "eslint": "8.54.0",
    "eslint-config-next": "14.1.0",
    "postcss": "8.4.31",
    "tailwindcss": "3.3.5",
    "tsx": "^4.19.2",
    "typescript": "5.3.3",
    "vitest": "0.34.6"
  }
}
